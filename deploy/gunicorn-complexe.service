[Unit]
Description=Gunicorn Behanian Local
After=network.target

[Service]
User=behanian
Group=www-data
WorkingDirectory=/opt/behanian
EnvironmentFile=/opt/behanian/.env
ExecStart=/opt/behanian/venv/bin/gunicorn \
    --workers 2 \
    --timeout 120 \
    --max-requests 500 \
    --max-requests-jitter 50 \
    --bind 127.0.0.1:8000 \
    config.wsgi:application
Restart=always
RestartSec=5
TimeoutStopSec=30
MemoryMax=450M

[Install]
WantedBy=multi-user.target
